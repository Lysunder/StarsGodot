# Godot 4+ specific ignores
.godot/
/android/

# Generated by Godot's CSV translation importer (written next to the source file)
*.translation

# Test reports
/reports/

# Python
__pycache__/
*.pyc

# Third-party reference material (not ours to publish)
/docs/

# Local assistant notes
/CLAUDE.md

# Local status report
/STATUS.md

# The original game's files and anything converted from them (decision D13): never committed
*.bmp
*.dib
*.ico
*.cur
*.hlp
*.exe
*.dll
*.wav
/classic/

# Build stamp written by tools/build.sh while it exports
/build_info.json
